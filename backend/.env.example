# API REST - Control de Gastos
PORT=4000

# Base de datos PostgreSQL local
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/control_gastos?schema=public"

# Secreto para firmar los JWT
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GENERA_UN_SECRETO_AQUI"

# Origen permitido por CORS (frontend Angular)
CORS_ORIGIN="http://localhost:4200"